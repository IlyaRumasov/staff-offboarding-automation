      "id": "7f2cf73b-52de-4929-820a-7b40c6de198c",
      "name": "[Redmine] Fetch Leaver Tasks",
      "type": "n8n-nodes-redmine.redmine",
      "typeVersion": 1,
      "position": [
        2080,
        1392
      ],
      "credentials": {
        "redmineApi": {
          "id": "8iS6GePvGFXR3dlv",
          "name": "Redmine bot account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst today = new Date();\ntoday.setHours(0,0,0,0);\n\nconst inputItems = $input.all();\nlet itemsToProcess = [];\n\nif (inputItems.length === 1 && inputItems[0].json.issues && Array.isArray(inputItems[0].json.issues)) {\n    itemsToProcess = inputItems[0].json.issues;\n} else {\n    itemsToProcess = inputItems.map(i => i.json);\n}\n\nfor (const issue of itemsToProcess) {\n  if (!issue || !issue.tracker) continue;\n  if (issue.tracker.id !== 41) continue;\n\n  const description = issue.description || \"\";\n  const subject = issue.subject || \"\";\n  const id = issue.id;\n\n  const adMatch = description.match(/AD\\s*-\\s*([^\\n\\r]*)/i);\n  \n  let dateStr = null;\n  const dateMatch1 = subject.match(/(\\d{4}-\\d{2}-\\d{2})\\s*$/);\n  const dateMatch2 = subject.match(/\\|\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/);\n\n  if (dateMatch1) dateStr = dateMatch1[1];\n  else if (dateMatch2) dateStr = dateMatch2[1];\n\n  if (adMatch && dateStr) {\n    const login = adMatch[1].trim();\n    const leaverDate = new Date(dateStr);\n    leaverDate.setHours(0,0,0,0);\n\n    if (leaverDate < today) {\n      results.push({\n        json: {\n          id: id,\n          login: login,\n          leaver_date: dateStr,\n          subject: subject\n        }\n      });\n    }\n  }\n}\n\nreturn results;"
      },
      "id": "0d0c224d-fa7b-4894-aa43-5b57a941b484",
      "name": "Script: Filter Overdue Users",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
