    {
      "parameters": {
        "jsCode": "const results = [];\nconst inputItems = $input.all();\nlet itemsToProcess = [];\n\nif (inputItems.length > 0 && inputItems[0].json.issues && Array.isArray(inputItems[0].json.issues)) {\n    itemsToProcess = inputItems[0].json.issues;\n} else {\n    itemsToProcess = inputItems.map(i => i.json);\n}\n\n// Получаем сегодняшнюю дату в формате YYYY-MM-DD\nconst today = new Date().toISOString().split('T')[0];\n\nfor (const issue of itemsToProcess) {\n    if (!issue) continue;\n\n    // --- НОВЫЙ БЛОК: Ищем кастомное поле Termination date (ID 30) ---\n    const termDateObj = (issue.custom_fields || []).find(f => f.id === 30);\n    const termDate = termDateObj && termDateObj.value ? termDateObj.value : null;\n\n    // ВАЖНО: Теперь приоритет у Termination date. \n    // Если пусто — fallback на due_date, если и там пусто — на start_date или today.\n    const leaverDate = termDate || issue.due_date || issue.start_date || today; \n    // -----------------------------------------------------------------\n\n    // Если дата увольнения больше сегодняшней (человек увольняется в будущем) — пропускаем!\n    if (leaverDate > today) {\n        continue; \n    }\n\n    const description = issue.description || \"\";\n    \n    // 1. Вытягиваем email для переадресации\n    const emailMatch = description.match(/Переадресація (?:пошти|диску):\\s*([a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+\\.[a-zA-Z0-9_-]+)/i);\n    const newOwnerEmail = emailMatch ? emailMatch[1].trim() : '';\n\n    // 2. Получаем ФИО\n    const contractorEngObj = (issue.custom_fields || []).find(f => f.id === 11);\n    const contractorEng = contractorEngObj ? contractorEngObj.value.trim() : '';\n\n    const contractorUkrObj = (issue.custom_fields || []).find(f => f.id === 103);\n    const contractorUkr = contractorUkrObj ? contractorUkrObj.value.trim() : '';\n\n    let firstName = '';\n    let lastName = '';\n    let possibleLogins = [];\n\n    // 3. Генерируем логины\n    if (contractorEng) {\n        const nameParts = contractorEng.split(/\\s+/);\n        if (nameParts.length >= 2) {\n            firstName = nameParts[0].toLowerCase();\n            lastName = nameParts[nameParts.length - 1].toLowerCase();\n\n            possibleLogins = [\n                `${firstName}.${lastName}`,\n                `${lastName}.${firstName}`,\n                `${firstName[0]}.${lastName}`,\n                `${firstName[0]}${lastName}`,\n                `${firstName}${lastName[0]}`\n            ];\n        }\n    }\n\n    // 4. Формируем финальный объект\n    if (firstName && lastName) {\n        results.push({\n            json: {\n                ticket_id: issue.id,\n                contractor_eng: contractorEng,\n                contractor_ukr: contractorUkr,\n                first_name: firstName,\n                last_name: lastName,\n                primary_guess_email: `${firstName}.${lastName}@corp.example.com`,\n                possible_logins: possibleLogins,\n                new_owner_email: newOwnerEmail,\n                leaver_date: leaverDate // Передаем проверенную дату завершения\n            }\n        });\n    }\n}\n\nreturn results;"
      },
